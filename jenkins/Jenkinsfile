// Orbit CLI 빌드 게이트 — Jenkins Declarative Pipeline 샘플
//
// 실제 파이프라인에 적용하는 템플릿입니다.
//   Build → Tag → scan image → Push → scan promote
// CLI 명령 자체(version, doctor, scan file)의 시험은 Jenkinsfile.cli-test에 있습니다.
// 단계는 서로의 결과 변수에 기대지 않습니다. 필요 없는 stage는 블록째 지워도 나머지가 동작합니다.
// 단, Build·Tag는 판정할 이미지를 만드는 단계라 scan image·Push·Promote를 쓰는 동안 남겨 둡니다.
//
// 에이전트: Kubernetes 플러그인으로 Pod(jnlp + docker:27-dind, privileged)를 띄우고,
//           모든 stage를 dind 컨테이너 안에서 실행합니다. stage마다 dockerd 기동을 기다립니다.
//           Docker가 있는 일반 에이전트에서 돌리려면 agent를 any로 바꾸고 container('dind') 블록을 걷어 냅니다.
//
// 필요한 자격(Manage Jenkins > Credentials)
//   orbit-client-id, orbit-client-secret : Secret text
//   orbit-address, orbit-issuer          : Secret text. 설치형(폐쇄망)만. 아래 ORBIT_*_CREDENTIALS_ID 참고
//   레지스트리 자격                      : Username with password. ID를 REGISTRY_CREDENTIALS_ID에 적습니다(로그인하지 않으면 none).

// 판정한 이미지를 올립니다. Push 단계가 REGISTRY_CREDENTIALS_ID로 자격을 넘겼을 때만 로그인하고(none이면 넘기지 않음),
// 로그인 호스트는 IMAGE에서 뽑습니다.
def PUSH_SCRIPT = '''
    REF="$IMAGE:${IMAGE_TAG:-$GIT_COMMIT}"
    case "$IMAGE" in ttl.sh/*) echo "경고: ttl.sh는 공개 임시 레지스트리입니다. 누구나 이 이미지를 받을 수 있습니다." ;; esac
    if [ -n "${REGISTRY_USERNAME:-}" ] && [ -n "${REGISTRY_TOKEN:-}" ]; then
      HOST="${IMAGE%%/*}"
      case "$HOST" in *.*|*:*|localhost) ;; *) HOST=docker.io ;; esac
      echo "$REGISTRY_TOKEN" | docker login -u "$REGISTRY_USERNAME" --password-stdin "$HOST"
    fi
    docker push "$REF"
'''

// Orbit 서버 주소(ORBIT_ADDRESS, ORBIT_ISSUER)를 Jenkins Credentials에서 읽어 body를 실행합니다.
//   두 Credentials가 모두 있으면 : 그 값을 CLI 컨테이너에 -e로 넘깁니다. 값은 콘솔 로그에서 가려집니다.
//   둘 다 없으면                 : 아무것도 넘기지 않아 CLI 이미지의 기본값(SaaS)을 씁니다.
//                                  빈 값을 -e로 넘기면 기본값을 덮어쓰므로 넘기지 않습니다.
//   하나만 있으면                : 서버와 인증 서버가 다른 환경을 가리킬 수 있어 멈춥니다.
// body 안의 docker 명령은 $ORBIT_SERVER_ARGS를 붙여 씁니다.
def withOrbitServer(Closure body) {
    def addressId = env.ORBIT_ADDRESS_CREDENTIALS_ID?.trim() ?: ''
    def issuerId  = env.ORBIT_ISSUER_CREDENTIALS_ID?.trim() ?: ''
    def hasAddress = orbitCredentialExists(addressId)
    def hasIssuer  = orbitCredentialExists(issuerId)
    if (hasAddress != hasIssuer) {
        error("ORBIT_ADDRESS와 ORBIT_ISSUER Credentials는 둘 다 등록하거나 둘 다 지웁니다 (있는 것: ${hasAddress ? addressId : issuerId})")
    }
    if (!hasAddress) {
        echo 'Orbit 서버: Credentials가 없어 CLI 이미지 기본값(SaaS)을 씁니다'
        withEnv(['ORBIT_SERVER_ARGS=']) { body() }
        return
    }
    echo 'Orbit 서버: Credentials의 주소를 씁니다(로그에서 가려집니다)'
    withCredentials([string(credentialsId: addressId, variable: 'ORBIT_ADDRESS'),
                     string(credentialsId: issuerId,  variable: 'ORBIT_ISSUER')]) {
        withEnv(['ORBIT_SERVER_ARGS=-e ORBIT_ADDRESS -e ORBIT_ISSUER']) { body() }
    }
}

// 해당 ID의 Secret text Credentials가 있으면 true. 없으면 false, 그 밖의 오류는 그대로 던집니다.
def orbitCredentialExists(String id) {
    if (!id) { return false }
    try {
        withCredentials([string(credentialsId: id, variable: 'ORBIT_CREDENTIAL_PROBE')]) { }
        return true
    } catch (Exception e) {
        if (e.getMessage()?.contains('Could not find credentials')) { return false }
        throw e
    }
}

pipeline {
    agent {
        kubernetes {
            yaml '''
            apiVersion: v1
            kind: Pod
            spec:
              containers:
              - name: jnlp                      # 체크아웃·잡 제어 (git 포함)
                resources:
                  requests: {cpu: 100m, memory: 256Mi}
              - name: dind                      # Docker 데몬 + CLI. 빌드·판정·push가 모두 여기서 돕니다
                image: docker:27-dind
                securityContext: {privileged: true}
                env:
                - {name: DOCKER_TLS_CERTDIR, value: ""}
                resources:
                  requests: {cpu: 250m, memory: 512Mi}
                  limits:   {memory: 3Gi}       # CLI(Trivy)가 이 컨테이너 안에서 돕니다
            '''
        }
    }
    options { timeout(time: 20, unit: 'MINUTES') }

    environment {
        // ─── 여기만 바꿉니다 ────────────────────────────────────────────────
        // 판정하고 올릴 이미지. 예: registry.example.com/team/myapp
        // 첫 부분(registry.example.com)이 레지스트리 주소이며, push와 로그인 모두 이 주소로 갑니다.
        // 시연: ttl.sh/orbit/orbit-gate-hello-<임의 문자열> + IMAGE_TAG = '1h' (자격 불필요, 공개됨)
        IMAGE                   = '<레지스트리>/<네임스페이스>/<이름>'
        // 비우면 커밋 해시를 태그로 씁니다.
        IMAGE_TAG               = ''
        // 레지스트리 로그인. 둘 중 하나를 반드시 적습니다. 정하지 않으면 Push에서 멈춥니다.
        //   Credentials ID : 그 자격(Username with password)으로 로그인합니다.
        //   none           : 로그인하지 않습니다. ttl.sh나 이미 로그인된 에이전트일 때만 씁니다.
        REGISTRY_CREDENTIALS_ID = '<Credentials ID 또는 none>'
        // Orbit 서버 주소. 설치형(폐쇄망)만 해당하며, SaaS는 Credentials를 만들지 않으면 됩니다.
        // 주소가 파일과 로그에 드러나지 않도록 Secret text Credentials로 등록하고 그 ID를 적습니다.
        // 두 Credentials가 모두 있으면 그 값을, 둘 다 없으면 CLI 이미지 기본값(SaaS)을 씁니다. 하나만 있으면 멈춥니다.
        //   ORBIT_ADDRESS : pipelinegate 주소.  값 예: https://gate.<설치 도메인>
        //   ORBIT_ISSUER  : Keycloak realm 주소. 값 예: https://sso.<설치 도메인>/realms/<realm 이름>
        ORBIT_ADDRESS_CREDENTIALS_ID = 'orbit-address'
        ORBIT_ISSUER_CREDENTIALS_ID  = 'orbit-issuer'
        // ───────────────────────────────────────────────────────────────────

        CANDIDATE_IMAGE     = 'orbit-gate-candidate:local'
        // CLI 2.0.1에 digest로 고정되어 있습니다. 다른 버전은 README 참고
        ORBIT_CLI_IMAGE     = 'ghcr.io/oliveworks-io/orbit-cli:2.0.1@sha256:ce55fd53b389998ee2fa125ca6e5baf944384c1f9c56f5ff2c8e9bbe1e6aceca'
        ORBIT_CLIENT_ID     = credentials('orbit-client-id')
        ORBIT_CLIENT_SECRET = credentials('orbit-client-secret')
        // CLI 컨테이너에 넘길 환경변수. 컨테이너는 에이전트의 환경변수를 물려받지 않습니다.
        ORBIT_ENV_ARGS      = '-e JENKINS_URL -e JOB_NAME -e GIT_URL -e GIT_COMMIT -e BUILD_NUMBER -e ORBIT_CLIENT_ID -e ORBIT_CLIENT_SECRET'
    }

    stages {
        // 1) 푸시하지 않고 로컬에만 적재합니다.
        stage('Build') {
            steps {
                container('dind') {
                    sh 'until docker info >/dev/null 2>&1; do sleep 1; done'   // dockerd 기동 대기
                    sh 'docker build -t "$CANDIDATE_IMAGE" .'
                }
            }
        }

        // 2) 최종 이미지 참조를 붙입니다(푸시 아님). IMAGE를 설정하지 않았으면 여기서 멈춥니다.
        stage('Tag') {
            steps {
                container('dind') {
                    sh 'until docker info >/dev/null 2>&1; do sleep 1; done'   // dockerd 기동 대기
                    sh '''
                        case "$IMAGE" in
                          ''|*'<'*) echo "IMAGE를 설정하십시오. 예: registry.example.com/team/myapp / 시연: ttl.sh/orbit/orbit-gate-hello-<임의 문자열> (IMAGE_TAG=1h)"; exit 1 ;;
                        esac
                        docker tag "$CANDIDATE_IMAGE" "$IMAGE:${IMAGE_TAG:-$GIT_COMMIT}"
                    '''
                }
            }
        }

        // 3) 판정. 통과가 아닌 모든 경우(차단, 오류)에 중단합니다.
        stage('Orbit Security (scan image)') {
            steps {
                container('dind') {
                    script {
                        sh 'until docker info >/dev/null 2>&1; do sleep 1; done'   // dockerd 기동 대기
                        def status = 0
                        withOrbitServer {
                            status = sh(returnStatus: true, script: '''
                                REF="$IMAGE:${IMAGE_TAG:-$GIT_COMMIT}"
                                # 도커 소켓의 그룹 ID는 컨테이너를 띄워서 측정합니다.
                                SOCK_GID="$(docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \
                                  alpine:3 stat -c '%g' /var/run/docker.sock)"
                                # 플랫폼(아키텍처)을 손으로 적지 않습니다. 빌드는 이 노드의 아키텍처로 만들어집니다.
                                # 소켓 경로는 dind 컨테이너 안의 dockerd 기준으로 해석됩니다.
                                PLATFORM="$(docker image inspect --format '{{.Os}}/{{.Architecture}}' "$REF")"
                                docker run --rm $ORBIT_ENV_ARGS $ORBIT_SERVER_ARGS \
                                  --group-add "$SOCK_GID" \
                                  -v /var/run/docker.sock:/var/run/docker.sock \
                                  "$ORBIT_CLI_IMAGE" \
                                  scan image "$REF" --platform "$PLATFORM" --details --format json \
                                  > gate.json
                            ''')
                        }
                        sh 'cat gate.json || echo "(판정 응답 없음)"'
                        if (status != 0) { error("게이트 차단/오류 (exit=${status})") }
                    }
                }
            }
        }

        // 4) 판정한 그 이미지를 그대로 올립니다.
        stage('Push') {
            steps {
                container('dind') {
                    script {
                        sh 'until docker info >/dev/null 2>&1; do sleep 1; done'   // dockerd 기동 대기
                        def credId = env.REGISTRY_CREDENTIALS_ID?.trim() ?: ''
                        if (credId == '' || credId.contains('<')) {
                            error("REGISTRY_CREDENTIALS_ID를 정하십시오. 레지스트리 자격의 Credentials ID, 또는 로그인하지 않으려면 none")
                        }
                        if (credId != 'none') {
                            withCredentials([usernamePassword(credentialsId: credId,
                                    usernameVariable: 'REGISTRY_USERNAME', passwordVariable: 'REGISTRY_TOKEN')]) {
                                sh PUSH_SCRIPT
                            }
                        } else {
                            sh PUSH_SCRIPT
                        }
                    }
                }
            }
        }

        // 5) 확정 digest를 보고합니다. requestId는 gate.json에서, digest는 push된 이미지에서 직접 읽습니다.
        //    앞 단계를 지워 값이 없으면 건너뜁니다.
        stage('Orbit Promote (scan promote)') {
            steps {
                container('dind') {
                    sh 'until docker info >/dev/null 2>&1; do sleep 1; done'   // dockerd 기동 대기
                    script {
                        withOrbitServer {
                            sh '''
                                REF="$IMAGE:${IMAGE_TAG:-$GIT_COMMIT}"
                                REQUEST_ID="$(grep -o '"requestId" *: *"[^"]*"' gate.json 2>/dev/null | head -n 1 | cut -d'"' -f4 || true)"
                                DIGEST="$(docker inspect --format '{{index .RepoDigests 0}}' "$REF" 2>/dev/null | cut -d'@' -f2 || true)"
                                [ -n "$REQUEST_ID" ] || { echo "gate.json에 requestId가 없어 보고하지 않습니다"; exit 0; }
                                [ -n "$DIGEST" ]     || { echo "push된 digest가 없어 보고하지 않습니다"; exit 0; }
                                docker run --rm $ORBIT_ENV_ARGS $ORBIT_SERVER_ARGS "$ORBIT_CLI_IMAGE" \
                                  scan promote --request-id "$REQUEST_ID" --image-digest "$DIGEST"
                            '''
                        }
                    }
                }
            }
        }
    }

    post {
        // 차단 사유는 판정 출력이 유일한 기록입니다. 결과와 관계없이 보관합니다.
        always { archiveArtifacts artifacts: 'gate.json', allowEmptyArchive: true }
    }
}
