# orbit-gate-hello-clean — 빌드 게이트 시연용 이미지. 앱 소스가 없습니다.
#
# Dockerfile(취약 라이브러리 포함)의 대조군입니다. 취약점이 알려진 라이브러리를 넣지 않아
# 게이트가 통과로 판정하고 Push·Promote까지 이어지는 흐름을 보여 줍니다.
# 통과 여부는 조직의 게이트 정책이 정합니다. 베이스가 digest로 고정되어 있어 시간이 지나면
# 베이스에 새 CVE가 공개될 수 있습니다.
#
# 운영 이미지의 예가 아닙니다. 시연·시험 용도로만 씁니다.

# Dockerfile과 같은 베이스입니다. 패키지 DB가 있어 SBOM이 비지 않습니다(빈 SBOM은 CLI가 종료 코드 2로 중단합니다).
FROM cgr.dev/chainguard/wolfi-base@sha256:00fd4e9cdd9c5576c336d979fa663f9976f160c456b6ae9fe87e19c4e9c759a2

LABEL org.opencontainers.image.title="orbit-gate-hello-clean" \
      org.opencontainers.image.description="Orbit build gate demo image: no known vulnerable dependency" \
      org.opencontainers.image.source="https://github.com/oliveworks-io/orbit-cli-examples"

USER 65532:65532
CMD ["sh", "-c", "echo 'orbit-gate-hello-clean'; sleep infinity"]
